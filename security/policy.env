# HU-14 · Security policy for the image scan (Trivy). Sourced by security/scan-images.sh.
# Every value can be overridden from the environment, for example in a Jenkins job:
#   TRIVY_SEVERITY_BLOCK=CRITICAL ./security/scan-images.sh --own 1.2.3
# There are no credentials in this file.

# Trivy scanner, pinned by tag and digest (tag 0.76.1, published 2026-10-21). Bump it deliberately.
: "${TRIVY_IMAGE:=aquasec/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c}"

# Severities that block the promotion of a CircleGuard image. The initial HU-14 criterion is CRITICAL and HIGH.
# Valid values: UNKNOWN, LOW, MEDIUM, HIGH, CRITICAL (comma separated).
: "${TRIVY_SEVERITY_BLOCK:=CRITICAL,HIGH}"

# true = leave out vulnerabilities that have no fix yet. Default false: nothing is hidden. If you turn it on,
# the JSON/SARIF reports no longer list those vulnerabilities either.
: "${TRIVY_IGNORE_UNFIXED:=false}"

# Third-party images (databases, Kafka, observability stack) are scanned and reported in full, but by default
# they do NOT block: CircleGuard cannot patch an upstream image, it can only update or replace it. Their
# findings stay visible in the reports and in the summary. true = make them block as well.
: "${TRIVY_BLOCK_THIRD_PARTY:=false}"

# Directory (relative to the repository root) for JSON, SARIF and summary files. Not versioned.
: "${SECURITY_REPORT_DIR:=security/reports}"

# Docker volume that caches the Trivy vulnerability database between runs.
: "${TRIVY_CACHE_VOLUME:=trivy-cache}"

# Vulnerability exceptions with an expiry date (see security/lib/exceptions.sh and security/exceptions.tsv).
# Maximum term from approval, and review interval, in days. An exception past either limit stops being valid.
: "${EXCEPTION_MAX_DAYS_CRITICAL:=30}"
: "${EXCEPTION_MAX_DAYS_HIGH:=90}"
: "${EXCEPTION_REVIEW_DAYS_CRITICAL:=14}"
: "${EXCEPTION_REVIEW_DAYS_HIGH:=30}"
