# HU-14 · Kubernetes Secrets of CircleGuard: names and sources only, never values.
#
#   <k8s secret>  <key in the secret>  <SSM parameter under /circleguard/<env>/>  <consumers>
#
# The source of truth is AWS SSM Parameter Store (SecureString), created by infra/bootstrap-secrets.sh from
# infra/config/secrets.catalog (HU-01). security/k8s/create-secrets.sh copies them into the cluster; nothing is stored in Git.
# One Secret per purpose, so a pod only receives the keys it needs (least privilege), instead of one Secret with everything.
#
# k8s secret          key                    ssm parameter          consumers (verified in each application.yml)
circleguard-db        POSTGRES_USER          POSTGRES_USER          auth identity dashboard form promotion
circleguard-db        POSTGRES_PASSWORD      POSTGRES_PASSWORD      auth identity dashboard form promotion
circleguard-neo4j     NEO4J_PASSWORD         NEO4J_PASSWORD         promotion
circleguard-ldap      LDAP_ADMIN_PASSWORD    LDAP_ADMIN_PASSWORD    auth
circleguard-jwt       CG_JWT_SECRET          CG_JWT_SECRET          auth identity promotion notification gateway
circleguard-qr        CG_QR_SECRET           CG_QR_SECRET           auth notification gateway
circleguard-vault     CG_VAULT_SECRET        CG_VAULT_SECRET        identity
circleguard-vault     CG_VAULT_SALT          CG_VAULT_SALT          identity
circleguard-vault     CG_VAULT_HASH_SALT     CG_VAULT_HASH_SALT     identity
#
# PENDING in the HU-01 catalog (it does not create these parameters yet). Listed so that HU-13 and HU-10 can rely on the names:
#   grafana-admin     admin-user             GRAFANA_ADMIN_USER     grafana (deploy/k8s/observability/all-in-one.yaml already reads this Secret)
#   grafana-admin     admin-password         GRAFANA_ADMIN_PASSWORD grafana
