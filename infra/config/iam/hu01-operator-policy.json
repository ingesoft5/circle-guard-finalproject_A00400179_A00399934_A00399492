{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Identity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "PricingReadOnly",
      "Effect": "Allow",
      "Action": "pricing:GetProducts",
      "Resource": "*"
    },
    {
      "Sid": "DescribeOnlyWhatTheScriptsRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2" } }
    },
    {
      "Sid": "CreateNetworkOnlyWithProjectTag",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:ImportKeyPair"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-2", "aws:RequestTag/Project": "circleguard" }
      }
    },
    {
      "Sid": "TagOnlyWhileCreating",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "ImportKeyPair",
            "RunInstances"
          ]
        }
      }
    },
    {
      "Sid": "RunOnlyApprovedInstanceTypesWithImdsV2",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-2:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "circleguard",
          "ec2:InstanceType": ["t3.small", "c7i-flex.large", "m7i-flex.large"],
          "ec2:MetadataHttpTokens": "required"
        }
      }
    },
    {
      "Sid": "RunOnlyEncryptedSmallGp3Volumes",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-2:*:volume/*",
      "Condition": {
        "StringEquals": { "aws:RequestTag/Project": "circleguard", "ec2:VolumeType": "gp3" },
        "Bool": { "ec2:Encrypted": "true" },
        "NumericLessThanEquals": { "ec2:VolumeSize": "40" }
      }
    },
    {
      "Sid": "RunOnlyCanonicalUbuntuImages",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-2::image/*",
      "Condition": { "StringEquals": { "ec2:Owner": "099720109477" } }
    },
    {
      "Sid": "RunOnlyInsideCircleGuardNetwork",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-2:*:subnet/*",
        "arn:aws:ec2:us-east-2:*:security-group/*",
        "arn:aws:ec2:us-east-2:*:key-pair/*"
      ],
      "Condition": { "StringEquals": { "aws:ResourceTag/Project": "circleguard" } }
    },
    {
      "Sid": "RunCreatesItsNetworkInterface",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-2:*:network-interface/*"
    },
    {
      "Sid": "OperateOnlyCircleGuardResources",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:ModifySubnetAttribute",
        "ec2:AttachInternetGateway",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:AssociateRouteTable",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:ModifyInstanceCreditSpecification",
        "ec2:ModifyInstanceMetadataOptions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-2", "aws:ResourceTag/Project": "circleguard" }
      }
    },
    {
      "Sid": "CircleGuardSecretsCreateAndRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParametersByPath",
        "ssm:PutParameter",
        "ssm:AddTagsToResource"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-2:*:parameter/circleguard",
        "arn:aws:ssm:us-east-2:*:parameter/circleguard/*"
      ]
    },
    {
      "Sid": "PublicUbuntuAmiParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-2::parameter/aws/service/canonical/*"
    },
    {
      "Sid": "SecureStringThroughSsmOnly",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.us-east-2.amazonaws.com" } }
    }
  ]
}
