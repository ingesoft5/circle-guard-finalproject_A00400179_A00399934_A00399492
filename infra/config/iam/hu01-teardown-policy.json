{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DestroyOnlyCircleGuardResources",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DisassociateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteSubnet",
        "ec2:DeleteVpc",
        "ec2:DeleteKeyPair"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-2", "aws:ResourceTag/Project": "circleguard" }
      }
    },
    {
      "Sid": "PurgeCircleGuardSecrets",
      "Effect": "Allow",
      "Action": "ssm:DeleteParameters",
      "Resource": "arn:aws:ssm:us-east-2:*:parameter/circleguard/*"
    }
  ]
}
