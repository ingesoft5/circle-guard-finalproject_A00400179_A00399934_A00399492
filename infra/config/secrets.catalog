# Secret catalog of HU-01: names and generators only, never values.
#
#   <scope>  <NAME>  <generator>
#   scope:     tools/<tool>, or "env" (expands to dev, stage and prod: one independent value each)
#   generator: password (30 chars: upper, lower, digits and -_.), username (cg_ + 8 hex),
#              hex32 (256-bit key, 64 hex chars), hex8 (64-bit salt, 16 hex chars)
#
# infra/bootstrap-secrets.sh creates each missing value once in SSM Parameter Store as a
# SecureString named /circleguard/<scope>/<NAME>. Existing values are never overwritten,
# rotated or printed. The CG_VAULT_* keys encrypt identity data: rotating them requires an
# approved data migration.
tools/jenkins    JENKINS_ADMIN_PASSWORD  password
tools/sonarqube  SONAR_ADMIN_PASSWORD    password
tools/sonarqube  SONAR_DB_PASSWORD       password
tools/nexus      NEXUS_ADMIN_PASSWORD    password
env              POSTGRES_USER           username
env              POSTGRES_PASSWORD       password
env              NEO4J_PASSWORD          password
env              LDAP_ADMIN_PASSWORD     password
env              CG_JWT_SECRET           hex32
env              CG_QR_SECRET            hex32
env              CG_VAULT_SECRET         hex32
env              CG_VAULT_SALT           hex8
env              CG_VAULT_HASH_SALT      hex8
