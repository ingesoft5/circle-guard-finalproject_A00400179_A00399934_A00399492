# Non-secret settings of the prod environment host (HU-01): t3.small (2 vCPU, 2 GiB) with a 10 GiB
# gp3 disk, enough for Docker, its credentials and the isolation tests. Secrets live in
# SSM Parameter Store under /circleguard/prod/ (see infra/config/secrets.catalog).
ENV_SUBNET_CIDR=10.20.30.0/24
ENV_INSTANCE_TYPE=t3.small
ENV_VOLUME_GB=10
