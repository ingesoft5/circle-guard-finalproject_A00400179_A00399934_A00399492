# Non-secret configuration of the HU-01 infrastructure on AWS.
# Versioned on purpose: it must NEVER contain credentials. Operator-specific overrides
# (AWS_PROFILE, ADMIN_CIDRS, ...) go in infra/config/operator.local.env, ignored by Git.

PROJECT=circleguard
STORY=HU-01
AWS_REGION=us-east-2
AWS_AZ=us-east-2a

# Network. Environment subnets are defined in infra/config/envs/<env>.env.
VPC_CIDR=10.20.0.0/16
SUBNET_TOOLS_CIDR=10.20.0.0/24

# Ubuntu Server 24.04 LTS (amd64, gp3) resolved from Canonical's public SSM parameter.
# Set AMI_ID to pin an exact image.
AMI_SSM_PARAM=/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id
AMI_ID=
SSH_USER=ubuntu
SSH_KEY_DIR="$HOME/.ssh/circleguard"

# Tool servers (topology B, approved on 2026-11-02). The account is on the AWS free plan, which
# only launches free-tier eligible types; the largest is m7i-flex.large (2 vCPU, 8 GiB), and the
# vCPU quota (5) allows two of them running at once (4 vCPU).
#   ci     Jenkins + SonarQube + PostgreSQL. Jenkins recommends 4 GB for a small team and
#          SonarQube 4 GB for a small installation: together they use the 8 GiB host. Both keep
#          their vendor JVM defaults.
#   nexus  Nexus Repository alone: Sonatype's minimum host is 8 GB and its minimum heap 2703 MB;
#          heap + direct memory (2703 + 2703 MiB) stays within 2/3 of the host's 8192 MiB.
# Environments (dev, stage, prod) get no servers in HU-01: they are isolated by network only.
CI_INSTANCE_TYPE=m7i-flex.large
CI_VOLUME_GB=30
NEXUS_INSTANCE_TYPE=m7i-flex.large
NEXUS_VOLUME_GB=25

# Hosts power themselves off this many hours after boot (systemd timer; the instance stops and
# keeps its disk and data). 0 disables it, and the budget check then assumes 24 h per session.
# On the host: `sudo systemctl restart circleguard-autostop.timer` extends a session; during the
# 5-minute warning use `sudo shutdown -c && sudo systemctl restart circleguard-autostop.timer`
# (`shutdown -c` alone leaves no stop scheduled until the next boot or bootstrap run).
AUTO_STOP_HOURS=4
# Swap file on each host (GiB), with vm.swappiness=10: a last resort against out-of-memory kills,
# not extra capacity. 0 disables it.
SWAP_GB=2

# Ports published by the tool stacks. NEXUS_DOCKER_PORT is the Docker connector of the
# circleguard-docker repository.
JENKINS_HTTP_PORT=8080
SONARQUBE_HTTP_PORT=9000
NEXUS_HTTP_PORT=8081
NEXUS_DOCKER_PORT=8082

# Nexus Community Edition 3.96.5 requires accepting its EULA through the API before it is used.
# Accepting it is a team decision: review https://links.sonatype.com/products/nxrm/ce-eula and
# set to true to accept it (infra/bootstrap/nexus/configure.sh then accepts it via the API).
NEXUS_ACCEPT_EULA=false

# Administrative access: comma separated CIDRs allowed to reach SSH and the tool UIs.
# Empty = the operator's current public IPv4 (/32), detected at run time.
ADMIN_CIDRS=

# Local validation (--target local) on Docker Desktop: host port 8082 is usually taken on the
# workstation, so the Nexus Docker connector is published on 5000 instead.
LOCAL_NEXUS_DOCKER_HOST_PORT=5000

# Reference On-Demand prices (USD, Linux, us-east-2) used ONLY for cost previews, taken from the
# AWS Pricing API on 2026-11-02. Re-check with `infra/bootstrap-servers.sh --prices` (read-only).
# Variable names replace '.' and '-' of the type with '_'.
PRICES_REFERENCE_DATE=2026-11-02
PRICE_HOUR_t3_small=0.0208
PRICE_HOUR_c7i_flex_large=0.08479
PRICE_HOUR_m7i_flex_large=0.09576
PRICE_EBS_GP3_GB_MONTH=0.08
PRICE_IPV4_HOUR=0.005
# Data transfer out to the Internet, first tier (inbound and same-zone private traffic are free).
PRICE_DATA_OUT_GB=0.09

# Local cost estimate checked before creating or starting instances (lib/budget.sh). It is NOT a
# billing limit: AWS has no hard spending cap; the real cost is in the Billing console.
# A session is bounded by AUTO_STOP_HOURS; new volumes are reserved for EBS_RESERVE_DAYS; the
# data transfer reserve (GB out to the Internet) is added once.
HU01_BUDGET_USD=15
SESSION_HOURS_ESTIMATE=4
EBS_RESERVE_DAYS=45
DATA_OUT_GB_RESERVE=3

# vCPU needed with both servers running (2 x 2 vCPU); see infra/bootstrap-quota.sh.
QUOTA_VCPU_TARGET=4
