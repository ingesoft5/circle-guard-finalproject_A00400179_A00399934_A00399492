# Non-secret configuration of the HU-01 infrastructure on AWS.
# Versioned on purpose: it must NEVER contain credentials. Operator-specific overrides
# (AWS_PROFILE, ADMIN_CIDRS, ...) go in infra/config/operator.local.env, ignored by Git.

PROJECT=circleguard
STORY=HU-01
AWS_REGION=us-east-2
AWS_AZ=us-east-2a

# Network. Environment subnets are defined in infra/config/envs/<env>.env.
VPC_CIDR=10.20.0.0/16
SUBNET_TOOLS_CIDR=10.20.0.0/24

# Ubuntu Server 24.04 LTS (amd64, gp3) resolved from Canonical's public SSM parameter.
# Set AMI_ID to pin an exact image.
AMI_SSM_PARAM=/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id
AMI_ID=
SSH_USER=ubuntu
SSH_KEY_DIR="$HOME/.ssh/circleguard"

# Tool servers (topology A, approved decision X-4).
JENKINS_INSTANCE_TYPE=t3.medium
JENKINS_VOLUME_GB=30
SONARQUBE_INSTANCE_TYPE=t3.large
SONARQUBE_VOLUME_GB=30
NEXUS_INSTANCE_TYPE=t3.large
NEXUS_VOLUME_GB=40

# Ports published by the tool stacks. NEXUS_DOCKER_PORT is the Docker connector of the
# circleguard-docker repository.
JENKINS_HTTP_PORT=8080
SONARQUBE_HTTP_PORT=9000
NEXUS_HTTP_PORT=8081
NEXUS_DOCKER_PORT=8082

# Nexus Community Edition 3.96.5 requires accepting its EULA through the API before it is used.
# Accepting it is a team decision: review https://links.sonatype.com/products/nxrm/ce-eula and
# set to true to accept it (infra/bootstrap/nexus/configure.sh then accepts it via the API).
NEXUS_ACCEPT_EULA=false

# Administrative access: comma separated CIDRs allowed to reach SSH and the tool UIs.
# Empty = the operator's current public IPv4 (/32), detected at run time.
ADMIN_CIDRS=

# Local validation (--target local) on Docker Desktop: host port 8082 is usually taken on the
# workstation, so the Nexus Docker connector is published on 5000 instead.
LOCAL_NEXUS_DOCKER_HOST_PORT=5000

# Reference On-Demand prices (USD, Linux, us-east-2) used ONLY for cost previews.
# t3.large was confirmed by the team on 2026-10-30; the rest are published list prices to be
# verified with `infra/bootstrap-servers.sh --prices` (read-only AWS Pricing API).
PRICES_REFERENCE_DATE=2026-10-30
PRICE_HOUR_t3_small=0.0208
PRICE_HOUR_t3_medium=0.0416
PRICE_HOUR_t3_large=0.0832
PRICE_EBS_GP3_GB_MONTH=0.08
PRICE_IPV4_HOUR=0.005
