#!/bin/bash
set -euo pipefail
PUBLIC_IP="${public_ip}"
curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="server --tls-san $PUBLIC_IP --write-kubeconfig-mode 644" sh -
until /usr/local/bin/k3s kubectl get nodes 2>/dev/null | grep -q " Ready"; do sleep 5; done
sed "s#https://127.0.0.1:6443#https://$PUBLIC_IP:6443#" /etc/rancher/k3s/k3s.yaml > /tmp/kubeconfig
aws ssm put-parameter --region ${region} --name /circleguard/${environment}/kubeconfig --type SecureString --overwrite --value file:///tmp/kubeconfig
rm -f /tmp/kubeconfig
