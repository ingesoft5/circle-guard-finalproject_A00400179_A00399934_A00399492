# Non-secret values for the prod environment (HU-02).
# IMAGE_REGISTRY and IMAGE_TAG are intentionally empty: the deployment must
# provide them (Compose fails instead of falling back to a floating tag).
# BIND_ADDRESS=127.0.0.1 keeps the web port private until the TLS ingress of
# E2.6 is in place; expose it through an SSH tunnel or a reverse proxy.
COMPOSE_PROJECT_NAME=circleguard-prod
ENV_NAME=prod
IMAGE_REGISTRY=
IMAGE_NAMESPACE=circleguard
IMAGE_TAG=
WEB_PORT=3000
BIND_ADDRESS=127.0.0.1
RESTART_POLICY=always
TZ=America/Bogota
APP_MEM_LIMIT=1536m
APP_CPUS=2.0
