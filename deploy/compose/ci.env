# Non-secret overrides for the HU-06 pipeline on the ci host (m7i-flex.large, 8 GiB).
# The Jenkinsfile injects this file with CG_APP_ENV_FILE so the 15-container stack fits next to
# Jenkins and the DinD daemon. Values are caps, not reservations.
APP_MEM_LIMIT=384m
APP_CPUS=0.5
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50 -XX:MaxMetaspaceSize=128m -XX:+ExitOnOutOfMemoryError
POSTGRES_MEM_LIMIT=256m
NEO4J_MEM_LIMIT=768m
NEO4J_HEAP=384m
NEO4J_PAGECACHE=256m
KAFKA_MEM_LIMIT=512m
KAFKA_HEAP_OPTS=-Xms256m -Xmx384m
ZOOKEEPER_MEM_LIMIT=192m
ZOOKEEPER_HEAP_OPTS=-Xms96m -Xmx128m
REDIS_MEM_LIMIT=96m
LDAP_MEM_LIMIT=96m
WEB_MEM_LIMIT=64m
FILE_MEM_LIMIT=384m
GATEWAY_MEM_LIMIT=384m
FORM_MEM_LIMIT=512m
NOTIFICATION_MEM_LIMIT=512m
PROMOTION_MEM_LIMIT=512m
CG_WAIT_TIMEOUT=900
