# Non-secret values for the dev environment (HU-02).
# Secrets are NOT here: pass them with --env-file (see deploy/compose/README.md).
COMPOSE_PROJECT_NAME=circleguard-dev
ENV_NAME=dev
IMAGE_REGISTRY=localhost:5000
IMAGE_NAMESPACE=circleguard
IMAGE_TAG=1.0.0
WEB_PORT=3000
BIND_ADDRESS=127.0.0.1
RESTART_POLICY=unless-stopped
TZ=America/Bogota
# Docker Desktop usually has ~7.4 GiB. The caps below are not reservations;
# they keep the 15 containers inside that budget. See docker-compose.dev.yml.
APP_MEM_LIMIT=512m
APP_CPUS=0.5
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60 -XX:MaxMetaspaceSize=128m -XX:+ExitOnOutOfMemoryError
POSTGRES_MEM_LIMIT=384m
NEO4J_MEM_LIMIT=1g
NEO4J_HEAP=512m
KAFKA_MEM_LIMIT=768m
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
ZOOKEEPER_MEM_LIMIT=256m
ZOOKEEPER_HEAP_OPTS=-Xms128m -Xmx192m
REDIS_MEM_LIMIT=128m
LDAP_MEM_LIMIT=128m
WEB_MEM_LIMIT=64m
