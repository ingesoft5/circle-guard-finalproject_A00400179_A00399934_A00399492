# Non-secret values for the stage environment (HU-02).
# IMAGE_REGISTRY and IMAGE_TAG are intentionally empty: the deployment must
# provide them (Compose fails instead of falling back to a floating tag).
COMPOSE_PROJECT_NAME=circleguard-stage
ENV_NAME=stage
IMAGE_REGISTRY=
IMAGE_NAMESPACE=circleguard
IMAGE_TAG=
WEB_PORT=3000
BIND_ADDRESS=0.0.0.0
RESTART_POLICY=always
TZ=America/Bogota
APP_MEM_LIMIT=1024m
APP_CPUS=1.5
