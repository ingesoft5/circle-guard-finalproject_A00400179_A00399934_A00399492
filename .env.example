# =============================================================================
# CircleGuard - variables del entorno local de desarrollo
# =============================================================================
# Plantilla SIN valores. Copiela FUERA del repositorio y fuera de OneDrive, por
# ejemplo en ~/.circleguard/ (ver infra/README.md, "Entorno local de desarrollo"):
#   - middleware (docker-compose.dev.yml):  --env-file ~/.circleguard/dev.env
#   - microservicios (bootRun):             set -a; . ~/.circleguard/dev.env; . ~/.circleguard/dev-app.env; set +a
# Complete TODOS los valores con credenciales nuevas y aleatorias, por ejemplo
#   openssl rand -hex 24
# No reutilice credenciales que hayan estado en el repositorio: se consideran
# comprometidas. Docker Compose se niega a arrancar si una variable requerida
# esta vacia. Use solo caracteres alfanumericos y - _ . (sin '$', comillas ni espacios).

# --- PostgreSQL ---------------------------------------------------------------
# Usuario administrador de la instancia local (debe empezar por una letra).
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Neo4j --------------------------------------------------------------------
# El usuario es siempre "neo4j"; la contrasena requiere al menos 8 caracteres.
NEO4J_PASSWORD=

# --- OpenLDAP -----------------------------------------------------------------
LDAP_ADMIN_PASSWORD=

# --- Secretos de aplicacion (application.yml de los microservicios) -----------
# Firma de JWT y de QR: 32 bytes en hexadecimal (openssl rand -hex 32).
CG_JWT_SECRET=
CG_QR_SECRET=
# Boveda de identidades (identity-service). CG_VAULT_SALT debe ser hexadecimal.
# Cambiar estos valores deja ilegibles las identidades ya cifradas: no los rote
# sin un procedimiento de migracion aprobado.
CG_VAULT_SECRET=
CG_VAULT_SALT=
CG_VAULT_HASH_SALT=
